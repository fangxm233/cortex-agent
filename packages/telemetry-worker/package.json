{
  "name": "@cortex-agent/telemetry-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that ingests Cortex's anonymous product telemetry into D1 and serves a private dashboard.",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "wrangler dev --local",
    "query": "tsx scripts/query.ts",
    "symbolicate": "tsx scripts/symbolicate.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "source-map": "^0.8.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
