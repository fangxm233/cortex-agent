{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex",
  "version": "../../agent-server/package.json",
  "identifier": "dev.cortex.desktop",
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../web/dist/": "frontend-seed/",
      "src/setup/runtime_portablegit/LICENSE-APACHE": "licenses/portablegit-reader/LICENSE-APACHE",
      "src/setup/runtime_portablegit/README.md": "licenses/portablegit-reader/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
