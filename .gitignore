# Dependencies (match both real dirs and stray symlinks named node_modules)
node_modules

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Runtime state
agent-server/sessions.json
agent-server/session-registry.json
agent-server/mode.json
agent-server/costs.json
agent-server/costs.jsonl
agent-server/pending-tasks.json
agent-server/threads.json
agent-server/conversation-ledger.json
agent-server/schedules.json
agent-server/orient-state.json
agent-server/executions.json
agent-server/tasks/
agent-server/data/pi/
agent-server/dist/
agent-server/.bundle-package*/
agent-server/web/dist/
agent-server/src/**/*.js
agent-server/tests/**/*.js
agent-server/prompts/
agent-server/plugins/
agent-server/hooks/

# MkDocs build output
site/

client/dist/
packages/*/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/tauri-plugin-*/android/build/
desktop/tauri-plugin-*/android/.tauri/
desktop/tauri-plugin-*/android/.gradle/
desktop/tauri-plugin-*/android/local.properties
# Each plugin's build.rs regenerates these from its command list
desktop/tauri-plugin-*/permissions/autogenerated/
desktop/tauri-plugin-*/permissions/schemas/
client/cortex-client-*.tgz
agent-server/cortex-agent-server-*.tgz
client/cortex-agent-client-*.tgz

# The workspace installs from pnpm-lock.yaml, and npm never ships a package's lockfile
agent-server/package-lock.json
client/package-lock.json
# Each package's prepare script copies the root README in for its npm tarball
agent-server/README.md
client/README.md

# Machine-specific (generated per host)
AGENTS.local.md
agent-server/mcp-config.json
agent-server/.env
agent-server/session-hooks.json
.cortex-task.md
.cortex-task-*.md
.cortex-status
.cortex-status-*
.cortex-pid
.cortex-pid-*
.cortex-log
.cortex-log.txt
logs/
.claude/

# Task execution artifacts
tmp/
*.pid

# Planning docs live in ~/.cortex/plan, never in this repo
plan/

# Crash dumps
core_*.nvcudmp

# Python
__pycache__/
*.pyc
.venv/

# Generated: memory index files (auto-rebuilt by memory-watcher / memory-index-regen)
research-context/projects/*/experiments/index.md
research-context/projects/*/knowledge/index.md
research-context/projects/*/patterns/index.md

data/client-pids.json
data/client-version.json
agent-server/.env.client
agent-server/src/data/

# Run-local campaign configs: a committed campaign plus the operator's own paths and ports
benchmark/campaigns/.run-local-*.yaml

# Campaign records of real runs: they name the operator's machines and absolute paths,
# and nothing in the repository reads them
benchmark/campaigns/results/
benchmark/campaigns/terminal-bench-2.1-codex-xhigh-mounted-gate.yaml
benchmark/campaigns/terminal-bench-2.1-full-xhigh-baselines.yaml
benchmark/campaigns/terminal-bench-2.1-full-xhigh-baselines-r3.yaml
benchmark/campaigns/terminal-bench-2.1-full-xhigh-cortex.yaml
benchmark/campaigns/terminal-bench-2.1-full-xhigh-cortex-r3.yaml
benchmark/campaigns/terminal-bench-2.1-full-xhigh-cortex-r3-refill.yaml
benchmark/campaigns/terminal-bench-2.1-repair-gate.yaml
benchmark/campaigns/terminal-bench-2.1-tmpdir-gate.yaml
benchmark/campaigns/terminal-bench-2.1-verifier-environment-smoke.yaml
benchmark/campaigns/zero-paid-external-corpus.yaml

# Deploy configs carrying a worker's real custom domain and ids, local dev secrets, wrangler state
packages/*/wrangler.local.toml
packages/*/.dev.vars
packages/*/.wrangler/

# Node module compile cache written by the test runner
agent-server/node-compile-cache/

# Runtime archives staged by desktop/scripts/fetch-bundled-runtime.mjs
desktop/src-tauri/bundled-runtime/*
!desktop/src-tauri/bundled-runtime/.gitkeep
